{
  "name": "cyberdesk",
  "version": "2.0.0",
  "description": "CyberDesk local operations desktop",
  "author": "CyberDesk",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.cyberdesk.app",
    "productName": "CyberDesk",
    "artifactName": "CyberDeskSetup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "build/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.com/cyberdesk"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/app-icon-gov.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CyberDesk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "build/setup-icon-gov.ico",
      "uninstallerIcon": "build/setup-icon-gov.ico",
      "installerHeaderIcon": "build/setup-header-gov.ico",
      "installerSidebar": "",
      "uninstallerSidebar": "",
      "menuCategory": "CyberDesk",
      "include": "build/installer-shortcuts.nsh"
    },
    "asar": true,
    "compression": "maximum"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
